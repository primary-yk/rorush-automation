{
  "name": "rorush-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/main.ts\" \"next dev -p 43123 -H 0.0.0.0\"",
    "discord-bot": "tsx bot/index.ts",
    "accounts": "tsx scripts/list-accounts.ts",
    "rain-joins": "tsx scripts/show-rain-joins.ts",
    "doctor": "tsx scripts/doctor.ts",
    "add-account": "tsx scripts/add-account-cli.ts",
    "activate-license": "tsx scripts/activate-license-cli.ts",
    "update-account": "tsx scripts/update-account-cli.ts",
    "test-login": "tsx scripts/test-login.ts",
    "test-stats": "tsx scripts/test-stats.ts",
    "last-rain-errors": "tsx scripts/last-rain-errors.ts",
    "test-captcha": "tsx scripts/test-captcha.ts",
    "discover-captcha": "tsx scripts/discover-rorush-captcha.ts",
    "test-limbo": "tsx scripts/test-limbo.ts",
    "test-rain-pipeline": "tsx scripts/test-limbo.ts -- --probe --with-captcha",
    "preflight": "tsx scripts/preflight.ts",
    "show-urls": "tsx scripts/show-dashboard-url.ts",
    "setup-discord-webhook": "tsx scripts/setup-discord-webhook.ts",
    "discord-bot-doctor": "tsx scripts/discord-bot-doctor.ts",
    "discord-login-smoke": "tsx scripts/discord-login-smoke.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production concurrently -k \"node dist/main.js\" \"next start -p 43123 -H 0.0.0.0\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "license:keygen": "tsx scripts/license-keygen.ts",
    "license:issue": "tsx scripts/issue-license.ts"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.2.0",
    "uuid": "^11.0.5",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
