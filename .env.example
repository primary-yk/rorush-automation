# 32-byte key, base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY=

# RoRush API (defaults match the public web client)
RORUSH_API_BASE=https://api.rorush.com
RORUSH_SEC_RUSH=836457212

# Optional global HTTP/S proxy for all RoRush traffic (e.g. http://user:pass@host:port)
RORUSH_PROXY_URL=

# RoRush RAIN uses hCaptcha — use 2Captcha (CapSolver removed hCaptcha; CapMonster not supported):
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=2captcha
# CAPTCHA_POLL_MS=1000        # poll interval (default 1s — faster token pickup)
# CAPTCHA_MAX_POLLS=180       # max polls per task attempt
# CAPTCHA_TASK_ATTEMPTS=2     # new 2Captcha task after stall/timeout/worker fail (non-rain)
# CAPTCHA_CANCEL_AFTER_MS=110000  # cancel task stuck in processing, then retry attempt
# CAPTCHA_RAIN_CANCEL_AFTER_MS=55000   # rain: fail faster on 2Captcha "processing" stalls (~90s join window)
# CAPTCHA_RAIN_TASK_ATTEMPTS=2       # rain: new 2Captcha task after stall (default 2 — was 5)
# CAPTCHA_RAIN_HEDGE_AFTER_MS=0      # rain: extra parallel task if first is slow (0=off — saves money)
# CAPTCHA_RAIN_MAX_TASKS_PER_SLOT=3  # hard cap on paid createTask per account per rain
# CAPTCHA_RAIN_PAID_SOLVES=0         # emergency: stop all rain hCaptcha billing (join will fail until re-enabled)
# CAPTCHA_RAIN_DUAL_START=0          # second staggered task (off by default — do not enable unless needed)
# CAPTCHA_HTTP_TIMEOUT_MS=45000
# CAPTCHA_VERBOSE=1           # log progress while waiting on 2Captcha
# CAPTCHA_TOKEN_TTL_MS=110000 # drop cached token after this
# CAPTCHA_TOKEN_MAX_AGE_MS=90000 # at rain join, re-solve if token older than this
# RORUSH_HCAPTCHA_SITEKEY=    # only if RoRush changes sitekey (DevTools)
# RORUSH_SITE_URL=https://rorush.com/
# CAPMONSTER_API_KEY=   # unused — do not set; use CAPTCHA_API_KEY above

# Automation API (dashboard talks to this)
AUTOMATION_API_HOST=127.0.0.1
AUTOMATION_API_PORT=43124

# RoRush FunCoins vs real coins — background check (rain-enabled accounts only); switch only when funCoin detected
# WALLET_FUNCOIN_CHECK_MS=1800000

# Rain captcha — prewarm only within ~3 min of join (not on every pool tip). Cooldown after failed solve.
# RAIN_CAPTCHA_PREWARM_BEFORE_JOIN_MS=180000   # hub warm-up window before join opens
# CAPTCHA_SOLVE_START_LEAD_MS=95000            # paid solves only inside this window before join (not full 3m prewarm)
# CAPTCHA_LOW_BALANCE_USD=1                    # Discord + dashboard alert threshold
# CAPTCHA_BALANCE_CACHE_MS=120000
# CAPTCHA_ESTIMATE_USD=0.00299                 # stats page spend estimate per solve
# RAIN_CAPTCHA_FAIL_COOLDOWN_MS=120000   # after failed solve (was 5m — caused skip patterns)
# CAPTCHA_RAIN_DUAL_START_DELAY_MS=10000 # second task 10s after first (not 2 at once)
# RAIN_CAPTCHA_WORKER_RETRIES=3              # retries when 2Captcha says workers could not solve
# RAIN_CAPTCHA_WORKER_FAIL_COOLDOWN_MS=20000 # short cooldown before another task (not 5 min)
# Each account gets its own parallel hCaptcha solve (2 accounts ≈ 2 concurrent 2Captcha tasks).
# RAIN_CAPTCHA_PARALLEL_WAIT_MS=150000   # legacy; join now retries in slices until the window closes
# RAIN_CAPTCHA_WAIT_SLICE_MS=12000       # captcha wait chunk per join try (keeps retries through ~90s window)
# RAIN_JOIN_TRIES_PER_WINDOW=24          # captcha+join cycles per account per rain
# RAIN_JOIN_INTER_ATTEMPT_MS=3000        # pause between join retries
# RAIN_JOIN_SCHEDULE_DEBOUNCE_MS=5000    # min gap between starting join pipelines for same rain

# SignalR (RoRush WebSocket) — raise if you see "server timeout" / 1006 on idle connections
# SIGNALR_SERVER_TIMEOUT_MS=180000
# SIGNALR_KEEPALIVE_MS=15000

# Rate limiting (minimum ms between requests per account)
REQUEST_MIN_INTERVAL_MS=350
MAX_REQUEST_FAILURES=3

# SQLite database file
DATABASE_PATH=./data/rorush-automation.db

# License verification (public key — safe to ship). See docs/LICENSE-VENDOR.md
LICENSE_PUBLIC_KEY=

# Dev only on YOUR machine — never enable in builds you sell
LICENSE_DEV_SKIP=false

# --- Hosted SaaS (YOU run 24/7 — customers Discord-only, see docs/HOSTED-SAAS.md)
# HOSTED_SAAS=true
# LICENSE_PUBLIC_KEY=...

# --- Friends mode (3–4 friends: Discord only, NO licenses — default until you sell)
# Do NOT set HOSTED_SAAS, RUSH_PILOT_LICENSE, or DISCORD_BOT_RELAY_URL
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=          # your server id (Developer Mode → right-click server)
# HOST_DISCORD_USER_ID=      # your Discord user id — /setup server, /pause /resume
# DISCORD_HOST_DM_ALERTS=0   # after /setup server, errors go to #host-log (set 1 to also DM you)
# DISCORD_HOST_AUTO_JOIN_FEED_THREADS=0  # set 1 to auto-add host to every new private feed (default off — use /jump)
# DISCORD_SUPPORT_MENTION=@28ub   # shown to friends when something breaks (Discord ping text)
# DISCORD_BOT_WATCHING=@JacobFuture Khecker   # bot profile: "Watching …" (plain text, not a live @mention)
# DISCORD_SERVER_MEMBERS_INTENT=0 # only if Portal Server Members Intent is OFF (friends bots default ON when DISCORD_GUILD_ID is set)
# DISCORD_AUTO_CONNECT_ON_JOIN=1 # default OFF — auto-create private feed on server join; otherwise #connect / /connect
# DISCORD_ACTIVITY_CHANNEL_ID=  # optional; in friends mode alerts go to HOST DMs unless DISCORD_ACTIVITY_PUBLIC=1
# DISCORD_ACTIVITY_PUBLIC=0    # set 1 to post activity to DISCORD_ACTIVITY_CHANNEL_ID (friends may see it)

# --- Alert channel webhook (easiest — paste URL from Discord, no dashboard needed)
# Channel → Edit → Integrations → Webhooks → New webhook → Copy URL
# DISCORD_REPORT_WEBHOOK=...  # OLD server webhooks ignored when DISCORD_GUILD_ID+bot are set — remove from .env
# DISCORD_USE_REPORT_WEBHOOK=1 # opt-in only: also post to webhook (not recommended with friends threads)
# Then: npm run setup-discord-webhook   (sends a test message)

# --- Customer: connect local Pilot to vendor Discord bot (see docs/DISCORD-BOT.md)
# DISCORD_BOT_RELAY_URL=wss://relay.yourdomain.com/pilot
# PILOT_RELAY_LICENSE_KEY=   # dev only if LICENSE_DEV_SKIP and no dashboard activation

# --- Vendor: run `npm run discord-bot` on a server (never ship token to customers)
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_THREAD_PARENT_CHANNEL_ID=
# DISCORD_BOT_RELAY_PORT=43125

# Optional global limbo overrides (account dashboard settings usually enough)
# Limbo floor is 5 coins on RoRush; optional override (cents, cannot go below 5 coins):
# LIMBO_MIN_BET_CENTS=500
# LIMBO_MIN_MULTIPLIER_CENTS=130
