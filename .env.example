# 32-byte key, base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY=

# RoRush API (defaults match the public web client)
RORUSH_API_BASE=https://api.rorush.com
RORUSH_SEC_RUSH=836457212

# Optional global HTTP/S proxy for all RoRush traffic (e.g. http://user:pass@host:port)
RORUSH_PROXY_URL=

# RoRush RAIN uses hCaptcha — 2Captcha or CapSolver (CapMonster not supported for rain):
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=2captcha
# CAPTCHA_POLL_MS=1500   # status poll interval (default 1.5s; does not speed up 2Captcha workers)
# CAPMONSTER_API_KEY=   # unused — do not set; use CAPTCHA_API_KEY above

# Automation API (dashboard talks to this)
AUTOMATION_API_HOST=127.0.0.1
AUTOMATION_API_PORT=43124

# Rate limiting (minimum ms between requests per account)
REQUEST_MIN_INTERVAL_MS=350
MAX_REQUEST_FAILURES=3

# SQLite database file
DATABASE_PATH=./data/rorush-automation.db

# License verification (public key — safe to ship). See docs/LICENSE-VENDOR.md
LICENSE_PUBLIC_KEY=

# Dev only on YOUR machine — never enable in builds you sell
LICENSE_DEV_SKIP=false

# --- Hosted SaaS (YOU run 24/7 — customers Discord-only, see docs/HOSTED-SAAS.md)
# HOSTED_SAAS=true
# LICENSE_PUBLIC_KEY=...

# --- Friends mode (3–4 friends: Discord only, NO licenses — default until you sell)
# Do NOT set HOSTED_SAAS, RUSH_PILOT_LICENSE, or DISCORD_BOT_RELAY_URL
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=          # your server id (Developer Mode → right-click server)
# HOST_DISCORD_USER_ID=      # your Discord user id — allows /pause /resume
# DISCORD_ACTIVITY_CHANNEL_ID=  # optional #channel for rain/errors feed (bot needs Send Messages)

# --- Alert channel webhook (easiest — paste URL from Discord, no dashboard needed)
# Channel → Edit → Integrations → Webhooks → New webhook → Copy URL
# DISCORD_REPORT_WEBHOOK=https://discord.com/api/webhooks/123456789/abcdef...
# Then: npm run setup-discord-webhook   (sends a test message)

# --- Customer: connect local Pilot to vendor Discord bot (see docs/DISCORD-BOT.md)
# DISCORD_BOT_RELAY_URL=wss://relay.yourdomain.com/pilot
# PILOT_RELAY_LICENSE_KEY=   # dev only if LICENSE_DEV_SKIP and no dashboard activation

# --- Vendor: run `npm run discord-bot` on a server (never ship token to customers)
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_THREAD_PARENT_CHANNEL_ID=
# DISCORD_BOT_RELAY_PORT=43125

# Optional global limbo overrides (account dashboard settings usually enough)
# LIMBO_MIN_BET_CENTS=100
# LIMBO_MIN_MULTIPLIER_CENTS=130
