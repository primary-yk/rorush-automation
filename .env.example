# 32-byte key, base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY=

# RoRush API (defaults match the public web client)
RORUSH_API_BASE=https://api.rorush.com
RORUSH_SEC_RUSH=836457212

# Optional global HTTP/S proxy for all RoRush traffic (e.g. http://user:pass@host:port)
RORUSH_PROXY_URL=

# Captcha solving (CapMonster Cloud or compatible)
CAPMONSTER_API_KEY=

# Automation API (dashboard talks to this)
AUTOMATION_API_HOST=127.0.0.1
AUTOMATION_API_PORT=43124

# Rate limiting (minimum ms between requests per account)
REQUEST_MIN_INTERVAL_MS=350
MAX_REQUEST_FAILURES=3

# SQLite database file
DATABASE_PATH=./data/rorush-automation.db

# License verification (public key — safe to ship). See docs/LICENSE-VENDOR.md
LICENSE_PUBLIC_KEY=

# Dev only on YOUR machine — never enable in builds you sell
LICENSE_DEV_SKIP=false

# --- Customer: connect local Pilot to vendor Discord bot (see docs/DISCORD-BOT.md)
# DISCORD_BOT_RELAY_URL=wss://relay.yourdomain.com/pilot
# PILOT_RELAY_LICENSE_KEY=   # dev only if LICENSE_DEV_SKIP and no dashboard activation

# --- Vendor: run `npm run discord-bot` on a server (never ship token to customers)
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_THREAD_PARENT_CHANNEL_ID=
# DISCORD_BOT_RELAY_PORT=43125

# Optional global limbo overrides (account dashboard settings usually enough)
# LIMBO_MIN_BET_CENTS=100
# LIMBO_MIN_MULTIPLIER_CENTS=110
